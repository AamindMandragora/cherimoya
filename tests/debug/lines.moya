# flags: -gline-tables-only -O0
# dwarf: DW_AT_name	("twice")
# gdb: break twice
# gdb: run
# gdb: backtrace
# gdb: info locals
# expect: twice () at
# expect: No locals.
# expect: in start () at
# checks what gdb can do with only a line table

# a breakpoint by name still works, though there are no variables
let (n :: int) -> twice -> (r :: int) { n * 2 -| }
# a backtrace from twice reaches here with its lines
let () -> start -> (code :: int) { twice(21) - 42 -| }
