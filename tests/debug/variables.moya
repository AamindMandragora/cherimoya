# dwarf: DW_TAG_lexical_block
# dwarf: DW_ATE_unsigned_fixed
# dwarf: "const int"
# gdb: break variables.moya:60
# gdb: run
# gdb: info locals
# gdb: print limit
# gdb: ptype counter
# gdb: ptype letter
# gdb: step
# gdb: print found
# expect: small = -5
# expect: flag = true
# expect: letter = 113 'q'
# expect: symbol = 955 'λ'
# expect: fuzzy = 0.70196078431
# expect: half = 1.5
# expect: single = 2.25
# expect: double = 3.5
# expect: tiny = 1.75
# expect: wide = -0.5
# expect: brain = 0.375
# expect: quad = 6.125
# expect: counter = 7
# expect: $1 = 200
# expect: type = int
# expect: type = const char
# expect: $2 = 7
# checks that every kind of value prints right in gdb

# a top-level binding prints like a local one
let limit :: i8u <- 200;
let (n :: int) -> show -> (r :: int) {
    # a 1-byte integer prints as a number, not a C char
    let small :: i8 <- -5;
    # a bool prints as true or false
    let flag <- true;
    # a character prints as its number and itself, and its type is const since it's immutable
    let letter <- 'q';
    # a rune prints as its number and itself too
    let symbol :: rune <- '\u{3BB}';
    # a boolf prints as its fraction
    let fuzzy :: boolf <- 0.7;

    ## floats gdb decodes itself
    let half :: f16 <- 1.5;
    let single :: f32 <- 2.25;
    let double <- 3.5;

    ## floats the embedded printers decode from their bits
    let tiny :: f8 <- 1.75;
    let wide :: f8e5m2n <- -0.5;
    let brain :: f16e8m7 <- 0.375;
    let quad :: f128 <- 6.125;

    # a mutable binding's type isn't const
    let counter :: mut <- 0;
    counter +<- n;
    # a match arm's binder is only in scope inside its arm
    match (n) {
        found -> { found + counter -| show }
    }
}
let () -> start -> (code :: int) { show(7) - 14 -| }
