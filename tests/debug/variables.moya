# checks that every kind of value prints right: integers, bools, characters, a boolf as its fraction, floats gdb decodes itself, the ones the embedded printers decode, an immutable binding as const, a mutable one as not, a top-level binding, and a match arm's binder only inside its arm
let limit :: i8u <- 200;
let (n :: int) -> show -> (r :: int) {
    let small :: i8 <- -5;
    let flag <- true;
    let letter <- 'q';
    let symbol :: rune <- '\u{3BB}';
    let fuzzy :: boolf <- 0.7;
    let half :: f16 <- 1.5;
    let single :: f32 <- 2.25;
    let double <- 3.5;
    let tiny :: f8 <- 1.75;
    let wide :: f8e5m2n <- -0.5;
    let brain :: f16e8m7 <- 0.375;
    let quad :: f128 <- 6.125;
    let counter :: mut <- 0;
    counter +<- n;
    match (n) {
        found -> { found + counter -| show }
    }
}
let () -> start -> (code :: int) { show(7) - 14 -| }
