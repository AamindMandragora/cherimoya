# dwarf: DW_TAG_structure_type
# dwarf: DW_TAG_pointer_type
# dwarf: "addr[arr[int]]"
# dwarf: "addr[int]"
# gdb: break handles.moya:37
# gdb: run
# gdb: print xs
# gdb: print bytes
# gdb: print grid
# gdb: print p[0]
# gdb: print table
# gdb: print a
# gdb: print b
# expect: $1 = arr[int] of 3 = {1, 2, 3}
# expect: $2 = arr[i8] of 2 = {-1, 7}
# expect: $3 = arr[arr[int]] of 2 = {arr[int] of 1 = {5}, arr[int] of 1 = {5}}
# expect: $4 = 42
# expect: $5 = arr[int] of 2 = {0, 0}
# expect: $6 = addr 0x
# expect: $7 = addr 0x
# checks how gdb shows arrays on the heap, pointers, and addresses

# a top-level array on the heap is a global like any binding
let table <- arr[int]([0, 0]);
let () -> start -> (code :: int) {
    # an array on the heap shows as its elements
    let xs <- arr[int]([1, 2, 3]);
    # with 1-byte elements as numbers
    let bytes <- arr[i8]([-1, 7]);
    # nested ones too
    let grid <- arr[table.len(), arr[int]](arr[int]([5]));
    # a pointer is a pointer gdb follows
    let p <- ptr[int](42);
    # an address shows in hex, an array's with its length
    let a <- addr xs;
    let b <- addr p;
    int(xs.len()) + p[] -|
}
