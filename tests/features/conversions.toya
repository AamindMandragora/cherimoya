# checks integer conversions

# converts an i8u, which can be past what an i8 holds
let (x :: i8u) -> toSigned -> (r :: i8) { i8(x) -| }
# converts an i32, which can be negative
let (x :: i32) -> toUnsigned -> (r :: i32u) { i32u(x) -| }

@test
let () -> widen -> () {
    let small :: i8 <- -5;
    let wide <- i64(small);
    assert (wide = -5);
}

# narrowed through a pipe when the value fits
@test
let () -> narrowWhenFits -> () {
    let fits <- i8u(200 |> i16);
    assert (fits = 200);
}

# a value past the range wraps into a wrapping type
@test
let () -> wrapIntoWrapping -> () {
    let wrapped <- i8w(300);
    assert (wrapped = 44);
}

# the trap when an unsigned value doesn't fit a signed trapping type
@test(traps <- "'i8(x)' doesn't fit in i8")
let () -> unsignedPastSignedMax -> () {
    _ <- toSigned(200);
}

# the trap when a negative value doesn't fit an unsigned trapping type
@test(traps <- "'i32u(x)' doesn't fit in i32u")
let () -> negativeIntoUnsigned -> () {
    _ <- toUnsigned(-1);
}
