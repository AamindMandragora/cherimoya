# checks bool logic and its compound assignments

# takes a remainder by n, so it traps when it's called with 0
let (n :: int) -> divides -> (r :: bool) { 84 % n = 0 -| }
## each divides by n, so it traps when it's called with 0
let (n :: int) -> bad -> (b :: bool) { 1 / n = 1 -| }
let (n :: int) -> badf -> (x :: boolf) { boolf(f64(1 / n)) -| }

# && doesn't run its right side once its left is false
@test
let () -> andSkipsRight -> () {
    let a <- false && divides(0);
    assert (!a);
}

# || doesn't run its right side once its left is true
@test
let () -> orSkipsRight -> () {
    let b <- true || divides(0);
    assert (b);
}

# ^^ on bools
@test
let () -> exclusiveOr -> () {
    let c <- true ^^ false;
    assert (c);
}

# &&<- doesn't run its value once the binding is false
@test
let () -> andAssignSkips -> () {
    let ok :: mut <- false;
    ok &&<- bad(0);
    assert (!ok);
}

# ||<- on bools
@test
let () -> orAssign -> () {
    let ok :: mut <- false;
    ok ||<- true;
    assert (ok);
}

# ||<- doesn't run its value once the binding is true
@test
let () -> orAssignSkips -> () {
    let ok :: mut <- true;
    ok ||<- bad(0);
    assert (ok);
}

# ^^<- on bools
@test
let () -> exclusiveOrAssign -> () {
    let ok :: mut <- true;
    ok ^^<- true;
    assert (!ok);
}

# ||<- on a boolf keeps the larger
@test
let () -> boolfOrAssign -> () {
    let best :: mut boolf <- 0.2;
    best ||<- 0.6;
    assert (i8u(best) = 153);
    best ||<- 0.4;
    assert (i8u(best) = 153);
}

# &&<- on a boolf keeps the smaller
@test
let () -> boolfAndAssign -> () {
    let trust :: mut boolf <- 1;
    trust &&<- 0.8;
    assert (i8u(trust) = 204);
}

# &&<- on a boolf doesn't run its value once the binding is 0
@test
let () -> boolfAndAssignSkips -> () {
    let none :: mut boolf <- 0;
    none &&<- badf(0);
    assert (i8u(none) = 0);
}

# ||<- on a boolf doesn't run its value once the binding is 1
@test
let () -> boolfOrAssignSkips -> () {
    let all :: mut boolf <- 1;
    all ||<- badf(0);
    assert (i8u(all) = 255);
}

# ^^<- on a boolf
@test
let () -> boolfExclusiveOrAssign -> () {
    let flip :: mut boolf <- 0.8;
    flip ^^<- 0.4;
    assert (i8u(flip) = 153);
}
