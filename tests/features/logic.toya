# checks && || and ^^ on bools, their compound assignments on bools and boolfs, and that && and || skip their right side, and &&<- and ||<- their value, once the answer is decided
let (n :: int) -> divides -> (r :: bool) { 84 % n = 0 -| }
# each divides by n, so it traps when it's called with 0
let (n :: int) -> bad -> (b :: bool) { 1 / n = 1 -| }
let (n :: int) -> badf -> (x :: boolf) { boolf(f64(1 / n)) -| }

@test
let () -> andSkipsRight -> () {
    let a <- false && divides(0);
    assert (!a);
}

@test
let () -> orSkipsRight -> () {
    let b <- true || divides(0);
    assert (b);
}

@test
let () -> exclusiveOr -> () {
    let c <- true ^^ false;
    assert (c);
}

@test
let () -> andAssignSkips -> () {
    let ok :: mut <- false;
    ok &&<- bad(0);
    assert (!ok);
}

@test
let () -> orAssign -> () {
    let ok :: mut <- false;
    ok ||<- true;
    assert (ok);
}

@test
let () -> orAssignSkips -> () {
    let ok :: mut <- true;
    ok ||<- bad(0);
    assert (ok);
}

@test
let () -> exclusiveOrAssign -> () {
    let ok :: mut <- true;
    ok ^^<- true;
    assert (!ok);
}

@test
let () -> boolfOrAssign -> () {
    let best :: mut boolf <- 0.2;
    best ||<- 0.6;
    assert (i8u(best) = 153);
    best ||<- 0.4;
    assert (i8u(best) = 153);
}

@test
let () -> boolfAndAssign -> () {
    let trust :: mut boolf <- 1;
    trust &&<- 0.8;
    assert (i8u(trust) = 204);
}

@test
let () -> boolfAndAssignSkips -> () {
    let none :: mut boolf <- 0;
    none &&<- badf(0);
    assert (i8u(none) = 0);
}

@test
let () -> boolfOrAssignSkips -> () {
    let all :: mut boolf <- 1;
    all ||<- badf(0);
    assert (i8u(all) = 255);
}

@test
let () -> boolfExclusiveOrAssign -> () {
    let flip :: mut boolf <- 0.8;
    flip ^^<- 0.4;
    assert (i8u(flip) = 153);
}
