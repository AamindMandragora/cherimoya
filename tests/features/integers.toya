# checks integers

# a loop that multiplies
let (n :: int) -> factorial -> (r :: int) {
    let product :: mut <- 1;
    let i :: mut <- 2;
    repeat (i <= n) {
        product *<- i;
        i +<- 1;
    }
    product -|
}
# a loop that takes remainders
let (a :: int, b :: int) -> gcd -> (r :: int) {
    let x :: mut <- a;
    let y :: mut <- b;
    repeat (y != 0) {
        let t <- y;
        y <- x % y;
        x <- t;
    }
    x -|
}
# shifts a wrapping type
let (x :: i32w, n :: i32w) -> wrappingShl -> (r :: i32w) { x << n -| }
# shifts a trapping type, which traps when the amount is too far
let (x :: i32, n :: i32) -> trappingShl -> (r :: i32) { x << n -| }
# divides, which traps on 0
let (a :: i32w, b :: i32w) -> div -> (r :: i32w) { a / b -| }
# adds 100 in place, which can overflow
let (n :: i8) -> bump -> (r :: i8) {
    let x :: mut <- n;
    x +<- 100;
    x -|
}

@test
let () -> literal -> () {
    assert (67 = 67);
}

@test
let () -> binary -> () {
    assert (0b1000011 = 67);
}

@test
let () -> hex -> () {
    assert (0x43 = 67);
}

@test
let () -> octal -> () {
    assert (0o103 = 67);
}

# underscores in a literal
@test
let () -> separators -> () {
    assert (6_7 = 67);
}

# * and / bind tighter than + and -
@test
let () -> arithmeticPrecedence -> () {
    assert ((12 + 3) * 5 - 16 / 2 = 67);
}

# bitwise operators with a shift
@test
let () -> bitwisePrecedence -> () {
    assert ((1 << 5) | 8 ^ 2 = 42);
}

# the lowest i8
@test
let () -> narrowSigned -> () {
    let a :: i8 <- -128;
    assert (a < 0);
    assert (a = -128);
}

# an i8u past what an i8 holds
@test
let () -> narrowUnsigned -> () {
    let b :: i8u <- 200;
    assert (b > 100);
    assert (b = 200);
}

# the highest i128u, in hex
@test
let () -> wideUnsignedLiteral -> () {
    let c :: i128u <- 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF;
    assert (c > 0);
    assert (c = 340282366920938463463374607431768211455);
}

# the highest i128
@test
let () -> wideSignedLiteral -> () {
    let big :: i128 <- 170141183460469231731687303715884105727;
    assert (big > 0);
    assert (big = 0x7FFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF);
}

# an add past 255 wraps
@test
let () -> wrappingUnsignedAdd -> () {
    let d :: i8uw <- 250;
    let e <- d + 10;
    assert (e = 4);
}

# 200 + 100 wraps to 44
@test
let () -> wrappingAddWraps -> () {
    let x :: i8uw <- 200;
    let y <- x + 100;
    assert (y = 44);
}

# the lowest i8w divided by -1 wraps to itself
@test
let () -> wrappingMinDividedByMinusOne -> () {
    let m :: i8w <- -128;
    let q <- m / -1;
    assert (q = m);
}

# the lowest i8w has a remainder of 0 by -1
@test
let () -> wrappingMinRemainderMinusOne -> () {
    let m :: i8w <- -128;
    let r <- m % -1;
    assert (r = 0);
}

# negating the lowest i8w wraps to itself
@test
let () -> wrappingNegateMin -> () {
    let m :: i8w <- -128;
    let n <- -m;
    assert (n = m);
}

# dividing by -1 when nothing wraps
@test
let () -> wrappingDivideByMinusOne -> () {
    let d :: i8w <- 5;
    assert (d / -1 = -5);
    assert (d % -1 = 0);
}

# 255 compares as unsigned
@test
let () -> unsignedCompare -> () {
    let big :: i8u <- 255;
    let one :: i8u <- 1;
    assert (big > one);
}

# 255 divides as unsigned
@test
let () -> unsignedDivide -> () {
    let big :: i8u <- 255;
    assert (big / 2 = 127);
}

# a right shift on an unsigned type fills with 0s
@test
let () -> unsignedShiftRight -> () {
    let big :: i8u <- 255;
    assert (big >> 4 = 15);
}

# a right shift on a signed type copies the sign
@test
let () -> signedShiftRight -> () {
    let neg :: i8 <- -1;
    assert (neg >> 4 = -1);
}

# a shift past the width on a wrapping type wraps the amount
@test
let () -> wrappingShiftModulo -> () {
    assert (wrappingShl(1, 33) = 2);
}

@test
let () -> factorialLoop -> () {
    assert (factorial(5) = 120);
}

@test
let () -> gcdLoop -> () {
    assert (gcd(1071, 462) = 21);
}

# the trap for overflowing in a compound assignment
@test(traps <- "'x +<- 100' overflowed i8")
let () -> compoundOverflow -> () {
    _ <- bump(100);
}

# the trap for dividing by zero
@test(traps <- "'a / b' divided by zero")
let () -> divideByZero -> () {
    _ <- div(7, 0);
}

# the trap for shifting too far
@test(traps <- "'x << n' shifted by an amount outside 0 to 31")
let () -> shiftTooFar -> () {
    _ <- trappingShl(1, 32);
}
