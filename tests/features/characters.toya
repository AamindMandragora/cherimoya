# checks char and rune

# matches a char on a literal, an escape, and anything else
let (c :: char) -> kind -> (r :: int) {
    match (c) {
        'a' -> { 1 -| }
        '\n' -> { 2 -| }
        _ -> { 3 -| }
    } -|
}
# converts an int, which can be past what a char holds
let (n :: int) -> toChar -> (c :: char) { char(n) -| }
# converts an int, which can be a value a rune can't hold
let (n :: int) -> toRune -> (r :: rune) { rune(n) -| }

@test
let () -> matchLiteral -> () {
    assert (kind('a') = 1);
}

@test
let () -> matchEscape -> () {
    assert (kind('\n') = 2);
}

# a char with no arm of its own falls to the _ arm
@test
let () -> matchFallback -> () {
    assert (kind('z') = 3);
}

# a chain of comparisons on chars
@test
let () -> chainedCompare -> () {
    let isLower <- 'a' <= 'q' <= 'z';
    assert (isLower);
}

# an int converted to a char
@test
let () -> intToChar -> () {
    let shifted <- char(int('A') + 1);
    assert (shifted = 'B');
}

# a char widened into a rune
@test
let () -> charToRune -> () {
    let wide <- rune('b');
    assert (wide = 'b');
}

# a rune escape compared with a literal that isn't ASCII
@test
let () -> compareRunes -> () {
    let smile <- '\u{1F600}';
    let e :: rune <- 'é';
    assert (e < smile);
}

# runes converted to ints
@test
let () -> runeToInt -> () {
    let smile <- '\u{1F600}';
    let e :: rune <- 'é';
    assert (int(smile) = 0x1F600);
    assert (int(e) = 0xE9);
}

# a hex escape converted to a byte
@test
let () -> hexEscapeToByte -> () {
    assert (i8u('\x7F') = 127);
}

# a type annotation on an expression
@test
let () -> annotation -> () {
    assert ((5 :: int) = 5);
}

# the trap for an int past what a char holds
@test(traps <- "'char(n)' doesn't fit in char")
let () -> charTrap -> () {
    _ <- toChar(200);
}

# the trap for a surrogate, which a rune can't hold
@test(traps <- "'rune(n)' doesn't fit in rune")
let () -> runeTrap -> () {
    _ <- toRune(0xD800);
}
