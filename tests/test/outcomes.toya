# checks every outcome a test can have: passing, trapping as expected, failing an assert, finishing when it should have trapped, running past its timeout, and a nested test named after the function around it
let (a :: int, b :: int) -> add -> (r :: int) { a + b -| }
let (n :: int) -> square -> (r :: int) { n * n -| }

@test
let () -> adds_negatives -> () {
    assert (add(-1, -2) = -3);
}

@test(traps <- "overflowed int")
let () -> overflows -> () {
    _ <- square(4294967296);
}

@test
let () -> wrong -> () {
    assert (add(2, 2) = 5);
}

@test(traps <- "overflowed")
let () -> no_trap -> () {
    _ <- square(3);
}

@test(timeout <- 1)
let () -> stuck -> () {
    repeat { }
}

let () -> outer -> () {
    @test
    let () -> inner -> () { assert (square(3) = 9); }
}
