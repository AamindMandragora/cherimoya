let primes <- [2, 3, 5, 7];
let (xs :: arr[N] int) -> total -> (r :: int) {
    let sum :: mut <- 0;
    let i :: mut i64u <- 0;
    repeat (i < xs.len()) {
        sum +<- xs[i];
        i +<- 1;
    }
    sum -|
}
