# checks boolf literals, && || ^^ ! and *, comparisons, matches, short-circuiting, and conversions to and from floats, bytes, and bools
let (x :: boolf) -> level -> (r :: int) {
    match (x) {
        0 -> { 0 -| }
        1 -> { 2 -| }
        _ -> { 1 -| }
    } -|
}
# divides by n, so it traps when it's called with 0
let (n :: int) -> bad -> (x :: boolf) { boolf(f64(1 / n)) -| }
let () -> start -> (code :: int) {
    let warm :: boolf <- 0.8;
    let humid :: boolf <- 0.4;
    let both <- warm && humid;
    let either <- warm || humid;
    let neither <- !warm;
    let product <- warm * humid;
    let exactly <- warm ^^ humid;
    let back <- boolf(f32(0.25));
    let whole <- f64(boolf(true));
    # the right sides would trap, so they can't run
    let never :: boolf <- 0;
    let always :: boolf <- 1;
    let skipped <- (never && bad(0)) = 0 && (always || bad(0)) = 1;
    match (both = humid && either = warm && i8u(neither) = 51 && i8u(exactly) = 153 && i8u(back) = 64 && whole = 1.0 && warm > 0.5 && !(humid > 0.5) && skipped) {
        true -> { int(i8u(product)) + level(0) + level(true) + level(0.5) -| start }
        false -> { 1 -| start }
    }
}
