# exit: 12
# checks &&<- ||<- and ^^<- on bools and boolfs, where &&<- and ||<- skip their value once the place decides the answer
# each divides by n, so it traps when it's called with 0
let (n :: int) -> bad -> (b :: bool) { 1 / n = 1 -| }
let (n :: int) -> badf -> (x :: boolf) { boolf(f64(1 / n)) -| }
let () -> start -> (code :: int) {
    let ok :: mut <- false;
    ok &&<- bad(0);
    ok ||<- true;
    ok ||<- bad(0);
    ok ^^<- true;
    let best :: mut boolf <- 0.2;
    best ||<- 0.6;
    best ||<- 0.4;
    let trust :: mut boolf <- 1;
    trust &&<- 0.8;
    let none :: mut boolf <- 0;
    none &&<- badf(0);
    let all :: mut boolf <- 1;
    all ||<- badf(0);
    let flip :: mut boolf <- 0.8;
    flip ^^<- 0.4;
    match (!ok && i8u(best) = 153 && i8u(trust) = 204 && i8u(none) = 0 && i8u(all) = 255 && i8u(flip) = 153) {
        true -> { 12 -| start }
        false -> { 1 -| start }
    }
}
